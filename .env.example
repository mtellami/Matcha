DB_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://matcha:replace-with-local-password@db:5432/matcha
APP_ORIGIN=http://localhost:8080
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=hello@matcha.local
COOKIE_SECURE=false

# Optional social sign-in. Set a private, stable state secret before enabling either provider.
OAUTH_STATE_SECRET=
# Register these callback URLs with each provider when configuring OAuth:
# http://localhost:8080/api/v1/auth/google/callback
# http://localhost:8080/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3-compatible storage. Leave endpoint empty for AWS S3.
S3_ENDPOINT_URL=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=matcha-photos
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
S3_ADDRESSING_STYLE=path
# Local bootstrap only; provision private buckets separately in production.
S3_CREATE_BUCKET=true

# Mailpit: none/1025. Real SMTP: starttls/587 or ssl/465.
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
