{
  "name": "matcha-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write 'src/**/*' 'tests/**/*' 'e2e/**/*' '*.{json,html,ts}'",
    "format:check": "prettier --check 'src/**/*' 'tests/**/*' 'e2e/**/*' '*.{json,html,ts}'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "emoji-picker-react": "^5.1.4",
    "framer-motion": "^14.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
